{% extends 'base.html.twig' %}
{% block title %}Products - Our Store{% endblock %}
{% block body %}
    <div class="container my-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Our Products <span class="badge bg-secondary fs-6">{{ products|length }}</span></h1>
        </div>
        <div class="row row-cols-1 row-cols-md-3 g-4">
            {% for product in products %}
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    {% if product.image %}
                        <img src="{{ product.image }}" class="card-img-top" alt="{{ product.name }}" style="height: 220px; object-fit: cover;">
                    {% else %}
                        <div class="bg-light d-flex align-items-center justify-content-center" style="height: 220px;">
                            <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                        </div>
                    {% endif %}
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-primary mb-2 align-self-start">{{ product.category.name }}</span>
                        <h5 class="card-title">{{ product.name }}</h5>
                        <p class="card-text text-muted small flex-grow-1">{{ product.description|slice(0, 80) }}{% if product.description|length > 80 %}...{% endif %}</p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="fw-bold text-success fs-5">${{ product.price }}</span>
                            <a href="{{ path('app_product_details', {'id': product.id}) }}" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-eye me-1"></i>View Details
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="col-12 text-center py-5">
                <i class="bi bi-box-seam text-muted" style="font-size: 4rem;"></i>
                <p class="text-muted mt-3">No products available yet.</p>
            </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
